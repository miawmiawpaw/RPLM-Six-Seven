# Salin berkas ini menjadi .env lalu isi nilainya.
# JANGAN commit berkas .env — berkas ini hanya template.

# ─── Aplikasi ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Zona waktu wajib UTC+7 (WIB) — SRS §2.5
TZ=Asia/Jakarta

# ─── Basis Data (MySQL 8.0+) ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rental_alat_camping
DB_USER=root
DB_PASSWORD=

# ─── Autentikasi (JWT) ───────────────────────────────────────────────────────
# Masa berlaku belum ditetapkan — lihat docs/architecture.md §10.2 butir 3.
# Bangkitkan dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=30m

# ─── Midtrans (ADR-11) ───────────────────────────────────────────────────────
# Sandbox memakai awalan SB-. Produksi tidak.
# Ambil dari dashboard Midtrans: Settings → Access Keys.
MIDTRANS_SERVER_KEY=SB-Mid-server-
MIDTRANS_CLIENT_KEY=SB-Mid-client-
MIDTRANS_IS_PRODUCTION=false

# ─── Layanan Email (SMTP) ────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Rental Alat Camping <no-reply@example.com>"

# ─── URL Aplikasi ────────────────────────────────────────────────────────────
# Dipakai untuk menyusun tautan verifikasi email dan redirect setelah pembayaran.
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000/api

# ─── Penyimpanan Media (foto/video alat) ─────────────────────────────────────
# Lokasi belum ditetapkan — lihat docs/architecture.md §10.2 butir 2.
# Usulan: object storage, bukan disk VPS.
